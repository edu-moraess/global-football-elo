"""
Componentes de cards e narrativas reutilizáveis.
"""
import streamlit as st


def metric_cards(metrics, cols=4):
    """
    Renderiza cards de métricas em colunas.
    metrics: list of dicts {'label': str, 'value': str, 'help': str, 'delta': str}
    """
    columns = st.columns(cols)
    for i, m in enumerate(metrics):
        with columns[i % cols]:
            kwargs = {}
            if 'help' in m and m['help']:
                kwargs['help'] = m['help']
            if 'delta' in m and m['delta']:
                kwargs['delta'] = m['delta']
            st.metric(m['label'], m['value'], **kwargs)


def narrative_card(title, content, caption=None):
    """Card de narrativa com markdown."""
    st.markdown(
        f"<div style='background:linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);padding:18px;border-radius:10px;border-left:4px solid #e94560;margin-bottom:8px;'>"
        f"<h4 style='margin-top:0;color:#f0f0f0'>{title}</h4>"
        f"<p style='margin-bottom:0;color:#ccc;line-height:1.6'>{content}</p></div>",
        unsafe_allow_html=True
    )
    if caption:
        st.caption(caption)


def info_box(content, type="info"):
    """Caixa informativa colorida."""
    colors = {
        "info": "linear-gradient(135deg, #0f3460 0%, #1a1a2e 100%)",
        "success": "linear-gradient(135deg, #1a5c3a 0%, #1a1a2e 100%)",
        "warning": "linear-gradient(135deg, #5c4a1a 0%, #1a1a2e 100%)",
        "error": "linear-gradient(135deg, #5c1a1a 0%, #1a1a2e 100%)"
    }
    c = colors.get(type, colors["info"])
    st.markdown(
        f"<div style='background:{c};padding:14px 18px;border-radius:10px;margin:10px 0;color:#f0f0f0;line-height:1.6;'>"
        f"{content}</div>",
        unsafe_allow_html=True
    )
