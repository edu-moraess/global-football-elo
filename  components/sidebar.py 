"""Sidebar compartilhado."""
import streamlit as st

def render_sidebar(teams, default_home="Brazil", default_away="Argentina"):
    st.sidebar.markdown("<h2 style='text-align:center;'>⚽ Quant Football</h2>", unsafe_allow_html=True)
    st.sidebar.caption("Análise Quantitativa de Futebol")
    st.sidebar.divider()

    if 'home_team' not in st.session_state:
        st.session_state.home_team = default_home if default_home in teams else teams[0]
    if 'away_team' not in st.session_state:
        st.session_state.away_team = default_away if default_away in teams else teams[1]
    if 'neutral' not in st.session_state:
        st.session_state.neutral = True
    if 'lookback' not in st.session_state:
        st.session_state.lookback = 10

    home_team = st.sidebar.selectbox(
        "Seleção Principal", teams,
        index=teams.index(st.session_state.home_team) if st.session_state.home_team in teams else 0,
        key="sb_home"
    )
    away_team = st.sidebar.selectbox(
        "Seleção Oponente", teams,
        index=teams.index(st.session_state.away_team) if st.session_state.away_team in teams else 1,
        key="sb_away"
    )

    if home_team == away_team:
        st.sidebar.error("Selecione times diferentes.")
        st.stop()

    st.session_state.home_team = home_team
    st.session_state.away_team = away_team

    neutral = st.sidebar.toggle("Campo Neutro", value=st.session_state.neutral, key="sb_neutral")
    st.session_state.neutral = neutral

    lookback = st.sidebar.slider("Janela Temporal (anos)", 1, 20, st.session_state.lookback, key="sb_lookback")
    st.session_state.lookback = lookback

    return {
        'home_team': home_team,
        'away_team': away_team,
        'neutral': neutral,
        'lookback': lookback
    }
