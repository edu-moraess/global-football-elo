"""Charts v2 — Plotly com tema Bloomberg dark."""
import streamlit as st
import plotly.graph_objects as go
import plotly.express as px
import numpy as np
from .theme import GOLD, RED, GREEN, BLUE, DARK, CARD, BORDER, TEXT, MUTED

_LAYOUT = dict(
    paper_bgcolor='rgba(0,0,0,0)',
    plot_bgcolor='rgba(8,12,16,0)',
    font=dict(family='JetBrains Mono, monospace', color=TEXT, size=11),
    margin=dict(t=36, b=30, l=36, r=18),
    xaxis=dict(gridcolor=BORDER, zeroline=False, tickfont=dict(size=10)),
    yaxis=dict(gridcolor=BORDER, zeroline=False, tickfont=dict(size=10)),
)


def _apply(fig, **kwargs):
    fig.update_layout(**{**_LAYOUT, **kwargs})
    return fig


def plot_conf_scatter(conf_stats):
    fig = px.scatter(
        conf_stats, x='Média Elo', y='Desvio', size='Seleções',
        color='Confederação', text='Confederação', size_max=55,
        color_discrete_sequence=[GOLD, RED, GREEN, BLUE, '#A855F7', '#F97316'],
    )
    fig.update_traces(textposition='top center', textfont=dict(size=9))
    _apply(fig, title=dict(text='Força Média vs. Desigualdade Interna por Confederação',
                           font=dict(size=12, color=MUTED)))
    st.plotly_chart(fig, use_container_width=True)


def plot_momentum_bar(df):
    colors = [GREEN if v >= 0 else RED for v in df['Momentum']]
    fig = go.Figure(go.Bar(
        x=df['Momentum'], y=df['Seleção'], orientation='h',
        marker_color=colors, text=df['Momentum'].round(1),
        textposition='outside', textfont=dict(size=9),
    ))
    _apply(fig, title=dict(text='Momentum — Tendência Recente de Rating',
                           font=dict(size=12, color=MUTED)),
           xaxis_title='Δ Elo (MA5 – MA15)',
           yaxis=dict(autorange='reversed', tickfont=dict(size=9)))
    st.plotly_chart(fig, use_container_width=True)


def plot_prob_donut(p_home, p_draw, p_away, home, away):
    fig = go.Figure(go.Pie(
        labels=[home, 'Empate', away],
        values=[p_home, p_draw, p_away],
        hole=0.62,
        marker=dict(colors=[GOLD, MUTED, BLUE],
                    line=dict(color=DARK, width=2)),
        textinfo='label+percent',
        textfont=dict(size=10),
        insidetextorientation='horizontal',
    ))
    fig.add_annotation(text=f"{max(p_home, p_away):.0%}",
                       x=0.5, y=0.52, showarrow=False,
                       font=dict(size=22, color=GOLD, family='JetBrains Mono'))
    fig.add_annotation(text="P(fav)", x=0.5, y=0.40, showarrow=False,
                       font=dict(size=9, color=MUTED))
    _apply(fig, showlegend=False, margin=dict(t=10, b=10, l=10, r=10))
    st.plotly_chart(fig, use_container_width=True)


def plot_score_heatmap(M, home, away, n=7):
    sub = M[:n, :n]
    text = [[f"{sub[i,j]:.1%}" for j in range(n)] for i in range(n)]
    fig = go.Figure(go.Heatmap(
        z=sub, x=list(range(n)), y=list(range(n)),
        text=text, texttemplate='%{text}',
        colorscale=[[0, DARK], [0.5, '#1E3A5F'], [1, GOLD]],
        showscale=False, xgap=2, ygap=2, textfont=dict(size=9),
    ))
    _apply(fig,
           xaxis_title=f"Gols {away}", yaxis_title=f"Gols {home}",
           title=dict(text='Matriz de Probabilidade de Placares',
                      font=dict(size=12, color=MUTED)),
           yaxis=dict(autorange='reversed', tickvals=list(range(n))))
    st.plotly_chart(fig, use_container_width=True)


def plot_radar(categories, vals_h, vals_a, name_h, name_a):
    cats = categories + [categories[0]]
    vh   = vals_h + [vals_h[0]]
    va   = vals_a + [vals_a[0]]
    fig  = go.Figure()
    fig.add_trace(go.Scatterpolar(r=vh, theta=cats, fill='toself',
                                  name=name_h, line=dict(color=GOLD, width=2),
                                  fillcolor=f'rgba(200,169,81,0.15)'))
    fig.add_trace(go.Scatterpolar(r=va, theta=cats, fill='toself',
                                  name=name_a, line=dict(color=BLUE, width=2),
                                  fillcolor=f'rgba(74,158,255,0.15)'))
    fig.update_layout(
        polar=dict(radialaxis=dict(visible=True, range=[0, 100],
                                   tickfont=dict(size=8), gridcolor=BORDER),
                   angularaxis=dict(tickfont=dict(size=9), gridcolor=BORDER),
                   bgcolor='rgba(0,0,0,0)'),
        showlegend=True,
        legend=dict(font=dict(size=9), bgcolor='rgba(0,0,0,0)'),
        paper_bgcolor='rgba(0,0,0,0)',
        margin=dict(t=30, b=30, l=50, r=50),
    )
    st.plotly_chart(fig, use_container_width=True)


def plot_elo_evolution(s, team, color=GOLD):
    s = s.copy().sort_values('date')
    s['ma20'] = s['elo_after'].rolling(20, min_periods=1).mean()
    s['std20'] = s['elo_after'].rolling(20, min_periods=1).std().fillna(0)

    fig = go.Figure()
    fig.add_trace(go.Scatter(
        x=s['date'], y=s['ma20'] + s['std20'],
        line=dict(width=0), showlegend=False,
        fillcolor=f'rgba(200,169,81,0.08)', hoverinfo='skip',
    ))
    fig.add_trace(go.Scatter(
        x=s['date'], y=s['ma20'] - s['std20'],
        fill='tonexty', line=dict(width=0), showlegend=False,
        fillcolor=f'rgba(200,169,81,0.08)', hoverinfo='skip',
    ))
    fig.add_trace(go.Scatter(
        x=s['date'], y=s['elo_after'], mode='lines',
        name='Elo', line=dict(color=MUTED, width=1, dash='dot'),
    ))
    fig.add_trace(go.Scatter(
        x=s['date'], y=s['ma20'], mode='lines',
        name='MA-20', line=dict(color=color, width=2),
    ))
    _apply(fig,
           title=dict(text=f'{team} — Evolução do Rating Elo',
                      font=dict(size=12, color=MUTED)),
           yaxis_title='Rating Elo',
           legend=dict(font=dict(size=9), bgcolor='rgba(0,0,0,0)'))
    st.plotly_chart(fig, use_container_width=True)


def plot_tournament_probs(df, top_n=16):
    sub = df.head(top_n)
    fig = go.Figure()
    stages = ['P(Oitavas)', 'P(Quartas)', 'P(Semi)', 'P(Final)', 'P(Título)']
    colors = [BORDER, MUTED, BLUE, RED, GOLD]
    for stage, color in zip(stages, colors):
        fig.add_trace(go.Bar(
            x=sub['Seleção'], y=sub[stage],
            name=stage, marker_color=color,
        ))
    _apply(fig,
           barmode='overlay',
           yaxis=dict(tickformat='.0%', gridcolor=BORDER),
           title=dict(text='Probabilidades por Fase — Top 16',
                      font=dict(size=12, color=MUTED)),
           legend=dict(font=dict(size=9), bgcolor='rgba(0,0,0,0)',
                       orientation='h', y=1.08),
           xaxis=dict(tickangle=-30, tickfont=dict(size=9)),
    )
    st.plotly_chart(fig, use_container_width=True)


def plot_sensitivity(df, home):
    fig = go.Figure()
    fig.add_trace(go.Scatter(
        x=df['Elo Shift'], y=df['P(Casa)'],
        name=home, line=dict(color=GOLD, width=2),
    ))
    fig.add_trace(go.Scatter(
        x=df['Elo Shift'], y=df['P(Empate)'],
        name='Empate', line=dict(color=MUTED, width=1.5, dash='dash'),
    ))
    fig.add_trace(go.Scatter(
        x=df['Elo Shift'], y=df['P(Fora)'],
        name='Fora', line=dict(color=BLUE, width=2),
    ))
    fig.add_vline(x=0, line_dash='dot', line_color=MUTED, line_width=1)
    _apply(fig, yaxis=dict(tickformat='.0%', gridcolor=BORDER),
           xaxis_title='Δ Elo (Casa)',
           title=dict(text='Análise de Sensibilidade — Impacto do Elo nas Probabilidades',
                      font=dict(size=12, color=MUTED)),
           legend=dict(font=dict(size=9), bgcolor='rgba(0,0,0,0)'))
    st.plotly_chart(fig, use_container_width=True)


def plot_h2h_timeline(h2h_df, team_a, team_b):
    colors = h2h_df['gd_a'].apply(
        lambda x: GOLD if x > 0 else (RED if x < 0 else MUTED))
    fig = go.Figure()
    for _, row in h2h_df.iterrows():
        c = GOLD if row['gd_a'] > 0 else (RED if row['gd_a'] < 0 else MUTED)
        fig.add_shape(type='line',
                      x0=row['date'], x1=row['date'],
                      y0=0, y1=row['gd_a'],
                      line=dict(color=c, width=1))
    fig.add_trace(go.Scatter(
        x=h2h_df['date'], y=h2h_df['gd_a'],
        mode='markers', marker=dict(color=colors, size=7),
        text=h2h_df['score'], hoverinfo='text+x',
        showlegend=False,
    ))
    fig.add_hline(y=0, line_color=BORDER, line_width=1)
    _apply(fig,
           yaxis_title=f'Saldo de Gols ({team_a})',
           title=dict(text=f'{team_a} vs {team_b} — Histórico de Confrontos',
                      font=dict(size=12, color=MUTED)))
    st.plotly_chart(fig, use_container_width=True)