}


def get_confederation(team: str) -> str:
    return _TEAM_CONF.get(team, 'Other')


def _k_base(elo: float) -> float:
    if elo < 2000:
        return 40.0
    elif elo < 2200:
        return 32.0
    elif elo < 2400:
        return 24.0
    else:
        return 16.0


def _goal_mult(gd: int) -> float:
    if gd <= 1:
        return 1.00
    elif gd == 2:
        return 1.50
    elif gd == 3:
        return 1.75
    else:
        return 1.75 + (gd - 3) * 0.10


def _expected(elo_a: float, elo_b: float, neutral: bool) -> float:
    adj = 0 if neutral else HOME_ADV
    return 1.0 / (1.0 + 10 ** ((elo_b - elo_a - adj) / ELO_SCALE))


def compute_elo_history(df: pd.DataFrame, lookback_years: int = 10):
    df = df.copy()
    df['date'] = pd.to_datetime(df['date'])
    df['home_team'] = df['home_team'].replace(NAME_MAP)
    df['away_team'] = df['away_team'].replace(NAME_MAP)
    df = df.dropna(subset=['home_score', 'away_score']).sort_values('date')

    if lookback_years:
        cutoff = df['date'].max() - timedelta(days=365 * lookback_years)
        df = df[df['date'] >= cutoff]

    ratings: dict[str, float] = {}
    history: list[dict] = []

    for _, row in df.iterrows():
        h, a = row['home_team'], row['away_team']
        hs, as_ = float(row['home_score']), float(row['away_score'])
        tourn = str(row.get('tournament', 'Friendly'))
        neutral = bool(row.get('neutral', False))

        if h not in ratings: ratings[h] = INITIAL_ELO
        if a not in ratings: ratings[a] = INITIAL_ELO

        elo_h, elo_a = ratings[h], ratings[a]
        exp_h = _expected(elo_h, elo_a, neutral)
        exp_a = 1 - exp_h

        res_h = 1.0 if hs > as_ else 0.5 if hs == as_ else 0.0
        res_a = 1.0 - res_h

        gd = abs(hs - as_)
        t_weight = TOURNAMENT_K.get(tourn, 0.80)
        k_h = _k_base(elo_h) * t_weight * _goal_mult(int(gd))
        k_a = _k_base(elo_a) * t_weight * _goal_mult(int(gd))

        ratings[h] = elo_h + k_h * (res_h - exp_h)
        ratings[a] = elo_a + k_a * (res_a - exp_a)

        base_rec = dict(
            date=row['date'],
            tournament=tourn,
            neutral=neutral,
            home_team=h,
            away_team=a,
            home_score=int(hs),
            away_score=int(as_),
        )
        history.append({**base_rec,
            'team': h, 'opponent': a, 'venue': 'home',
            'goals_for': int(hs), 'goals_against': int(as_),
            'result': res_h,
            'expected': exp_h,
            'elo_before': elo_h,
            'elo_after': ratings[h],
            'delta_elo': ratings[h] - elo_h,
        })
        history.append({**base_rec,
            'team': a, 'opponent': h, 'venue': 'away',
            'goals_for': int(as_), 'goals_against': int(hs),
            'result': res_a,
            'expected': exp_a,
            'elo_before': elo_a,
            'elo_after': ratings[a],
            'delta_elo': ratings[a] - elo_a,
        })

    return ratings, pd.DataFrame(history)