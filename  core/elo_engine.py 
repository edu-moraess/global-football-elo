    for t in teams:
        TEAM_TO_CONF[t] = conf

def get_confederation(team):
    return TEAM_TO_CONF.get(team, 'Outros')

def k_factor(elo, tournament, goal_diff):
    base = 40 if elo < 2100 else 20 if elo < 2400 else 10
    mult = {'FIFA World Cup': 1.5, 'Confederations Cup': 1.4,
            'UEFA Euro': 1.3, 'Copa América': 1.3, 'AFC Asian Cup': 1.3,
            'Africa Cup of Nations': 1.3, 'CONCACAF Gold Cup': 1.2,
            'Oceania Nations Cup': 1.1, 'FIFA World Cup qualification': 1.0,
            'UEFA Euro qualification': 1.0, 'Friendly': 0.8}
    tm = mult.get(tournament, 1.0)
    gd = 1 + (abs(goal_diff) - 1) * 0.5 if abs(goal_diff) > 1 else 1
    return base * tm * gd

def expected_score(elo_a, elo_b):
    return 1 / (1 + 10 ** ((elo_b - elo_a) / 400))

def compute_elo_history(df, lookback_years):
    from datetime import timedelta
    cutoff = df['date'].max() - timedelta(days=365 * lookback_years)
    df = df[df['date'] >= cutoff].sort_values('date').copy()
    ratings = {}
    history = []
    for _, row in df.iterrows():
        h, a = row['home_team'], row['away_team']
        hs, aw = row['home_score'], row['away_score']
        for t in (h, a):
            if t not in ratings:
                ratings[t] = INITIAL_ELO
        elo_h, elo_a = ratings[h], ratings[a]
        exp_h = expected_score(elo_h, elo_a)
        exp_a = 1 - exp_h
        if hs > aw:
            actual_h, actual_a = 1, 0
        elif hs == aw:
            actual_h, actual_a = 0.5, 0.5
        else:
            actual_h, actual_a = 0, 1
        k_h = k_factor(elo_h, row.get('tournament', 'Friendly'), hs - aw)
        k_a = k_factor(elo_a, row.get('tournament', 'Friendly'), aw - hs)
        ratings[h] = elo_h + k_h * (actual_h - exp_h)
        ratings[a] = elo_a + k_a * (actual_a - exp_a)
        history.append({
            'date': row['date'], 'team': h, 'rating': ratings[h],
            'opponent': a, 'home': True, 'goals_for': hs, 'goals_against': aw,
            'result': 1 if hs > aw else 0.5 if hs == aw else 0,
            'expected': exp_h, 'tournament': row.get('tournament', 'Friendly')
        })
        history.append({
            'date': row['date'], 'team': a, 'rating': ratings[a],
            'opponent': h, 'home': False, 'goals_for': aw, 'goals_against': hs,
            'result': 1 if aw > hs else 0.5 if aw == hs else 0,
            'expected': exp_a, 'tournament': row.get('tournament', 'Friendly')
        })
    return ratings, pd.DataFrame(history)
