"""
MetricsEngine v2 — Métricas quantitativas de performance por seleção.
"""
import numpy as np
import pandas as pd
from datetime import timedelta
from .elo_engine import get_confederation


def _team_series(history: pd.DataFrame, team: str, n: int | None = None) -> pd.DataFrame:
    s = history[history['team'] == team].sort_values('date')
    return s.tail(n) if n else s


def elo_volatility(history: pd.DataFrame, team: str, window: int = 10) -> float:
    s = _team_series(history, team)
    if len(s) < window + 1:
        return np.nan
    return float(s['delta_elo'].tail(window).std())


def elo_momentum(history: pd.DataFrame, team: str,
                 short: int = 5, long: int = 15) -> float:
    s = _team_series(history, team)
    if len(s) < long:
        return np.nan
    return float(s['elo_after'].tail(short).mean() - s['elo_after'].tail(long).mean())


def elo_efficiency(history: pd.DataFrame, team: str, n: int = 20) -> tuple[float, float]:
    s = _team_series(history, team).tail(n)
    if len(s) < 5:
        return np.nan, np.nan
    pts   = s['result'].apply(lambda r: 3 if r == 1 else (1 if r == 0.5 else 0))
    e_pts = s['expected'] * 3
    real  = float(pts.mean())
    edge  = float((pts - e_pts).mean())
    return real, edge


def schedule_strength(history: pd.DataFrame, team: str, n: int = 10) -> float:
    s = _team_series(history, team).tail(n)
    if len(s) < 3:
        return np.nan
    opp_elos = []
    for _, row in s.iterrows():
        opp_hist = history[(history['team'] == row['opponent']) &
                           (history['date'] <= row['date'])]
        opp_elos.append(opp_hist['elo_after'].iloc[-1] if len(opp_hist) else 1500)
    return float(np.mean(opp_elos))


def team_consistency(history: pd.DataFrame, team: str, n: int = 20) -> float:
    s = _team_series(history, team).tail(n)
    if len(s) < 5:
        return np.nan
    mu = s['elo_after'].mean()
    return float(s['elo_after'].std() / mu) if mu > 0 else np.nan


def form_index(history: pd.DataFrame, team: str, n: int = 5) -> float:
    s = _team_series(history, team).tail(n)
    if len(s) < 3:
        return np.nan
    weights = np.exp(np.linspace(0, 1, len(s)))
    weights /= weights.sum()
    pts = (s['result'] * 3).values
    return float(np.dot(pts, weights))


def clutch_performance(history: pd.DataFrame, team: str, n: int = 30) -> float:
    s = _team_series(history, team).tail(n)
    if len(s) < 10:
        return np.nan
    official = s[~s['tournament'].str.contains('Friendly', na=False)]
    friendly = s[ s['tournament'].str.contains('Friendly', na=False)]
    if len(official) < 3 or len(friendly) < 3:
        return np.nan
    return float(official['result'].mean() * 3 - friendly['result'].mean() * 3)


def brier_score(history: pd.DataFrame, team: str, n: int = 50) -> float:
    s = _team_series(history, team).tail(n)
    if len(s) < 10:
        return np.nan
    return float(((s['expected'] - s['result']) ** 2).mean())


def xg_over_expected(history: pd.DataFrame, team: str, n: int = 30) -> float:
    s = _team_series(history, team).tail(n)
    if len(s) < 5:
        return np.nan
    real_gf = s['goals_for'].mean()
    xg_proxy = s['expected'].mean() * 2.5
    return float(real_gf - xg_proxy)


def h2h_stats(df: pd.DataFrame, team_a: str, team_b: str,
              lookback: int = 30) -> dict:
    cutoff = df['date'].max() - timedelta(days=365 * lookback)
    h2h = df[
        ((df['home_team'] == team_a) & (df['away_team'] == team_b)) |
        ((df['home_team'] == team_b) & (df['away_team'] == team_a))
    ]
    h2h = h2h[h2h['date'] >= cutoff].sort_values('date')

    if h2h.empty:
        return dict(total=0, wins_a=0, wins_b=0, draws=0,
                    gd_sum=0, streak=0, edge='Sem dados', dominance=0.0,
                    first=None, last=None)

    wins_a = wins_b = draws = gd_sum = streak = cur_streak = 0
    for _, row in h2h.iterrows():
        gd = (row['home_score'] - row['away_score']) if row['home_team'] == team_a \
             else (row['away_score'] - row['home_score'])
        gd_sum += gd
        if gd > 0:   wins_a += 1;  cur_streak += 1
        elif gd < 0: wins_b += 1;  cur_streak  = 0
        else:        draws  += 1;  cur_streak  = 0
        streak = max(streak, cur_streak)

    total = len(h2h)
    dom = (wins_a - wins_b) / total
    edge = (f'Domínio {team_a}' if dom > 0.35
            else f'Domínio {team_b}' if dom < -0.35
            else f'Leve vant. {team_a}' if dom > 0.12
            else f'Leve vant. {team_b}' if dom < -0.12
            else 'Equilíbrio')

    return dict(
        total=total, wins_a=wins_a, wins_b=wins_b, draws=draws,
        gd_sum=gd_sum, streak=streak, edge=edge, dominance=dom,
        first=h2h['date'].min(), last=h2h['date'].max(),
    )


def home_adv_by_confederation(df: pd.DataFrame, confederations: dict) -> pd.DataFrame:
    rows = []
    for conf, teams in confederations.items():
        sub = df[(df['home_team'].isin(teams)) &
                 (df['away_team'].isin(teams)) &
                 (df['neutral'] == False)]
        if len(sub) < 50:
            continue
        hw = (sub['home_score'] > sub['away_score']).mean()
        aw = (sub['home_score'] < sub['away_score']).mean()
        dr = (sub['home_score'] == sub['away_score']).mean()
        rows.append(dict(
            Confederação=conf,
            **{'Home Win%': hw, 'Draw%': dr, 'Away Win%': aw,
               'Home Advantage Index': hw - aw,
               'Avg GD': (sub['home_score'] - sub['away_score']).mean(),
               'N': len(sub)}
        ))
    return pd.DataFrame(rows).sort_values('Home Advantage Index', ascending=False)


def tactical_profile(history: pd.DataFrame, team: str, n: int = 20) -> dict:
    s = _team_series(history, team).tail(n)
    if len(s) < 5:
        return {'xG': np.nan, 'xGA': np.nan,
                'pressao': np.nan, 'resiliencia': np.nan}
    xg  = s['expected'].mean() * 2.5
    xga = (1 - s['expected']).mean() * 2.5
    ud = s[s['expected'] < 0.40]
    pressao    = float(ud['goals_for'].mean())   if len(ud) >= 3 else np.nan
    resiliencia = float(ud['result'].mean() * 3) if len(ud) >= 3 else np.nan
    return {'xG': xg, 'xGA': xga, 'pressao': pressao, 'resiliencia': resiliencia}


def build_global_metrics(elo_ratings: dict, history: pd.DataFrame) -> pd.DataFrame:
    rows = []
    for team, elo in elo_ratings.items():
        vol   = elo_volatility(history, team)
        mom   = elo_momentum(history, team)
        eff_r, eff_e = elo_efficiency(history, team)
        sched = schedule_strength(history, team)
        cons  = team_consistency(history, team)
        fi    = form_index(history, team)
        bs    = brier_score(history, team)
        clutch = clutch_performance(history, team)
        xgoe  = xg_over_expected(history, team)
        tact  = tactical_profile(history, team)
        conf  = get_confederation(team)
        rows.append(dict(
            Seleção=team, Elo=round(elo, 1), Confederação=conf,
            Volatilidade=vol, Momentum=mom,
            Eficiência=eff_r, Edge=eff_e,
            ForcaAgenda=sched, Consistência=cons,
            Forma=fi, BrierScore=bs,
            ClutchIndex=clutch, xGOE=xgoe,
            xG=tact['xG'], xGA=tact['xGA'],
            Pressão=tact['pressao'], Resiliência=tact['resiliencia'],
        ))
    return pd.DataFrame(rows).sort_values('Elo', ascending=False).reset_index(drop=True)