import streamlit as st
import numpy as np
from scipy.signal import find_peaks
from core.data_loader import load_data, get_processed_data, LOOKBACK_YEARS
from core.metrics_engine import get_team_history, golden_window, generation_cycles
from components.sidebar import render_sidebar
from components.charts import plot_evolution
from components.cards import info_box

st.set_page_config(page_title="Evolução Temporal", layout="wide")

df = load_data()
elo_ratings, elo_history, attack, defense, league_avg = get_processed_data(df, LOOKBACK_YEARS)
teams = sorted(list(elo_ratings.keys()))
state = render_sidebar(teams)

st.title("🧬 Evolução Temporal")
st.markdown("Cada pico é uma geração dourada. Cada vale é uma transição dolorosa. Aqui vemos história em movimento.")

for team in [state['home_team'], state['away_team']]:
    st.divider()
    st.subheader(f"📈 {team}")
    s = get_team_history(elo_history, team, n_last=200)
    if s.empty or len(s) < 5:
        st.warning(f"Dados insuficientes para {team}.")
        continue
    plot_evolution(s, team)
    ratings_arr = s['rating'].values
    peaks, _ = find_peaks(ratings_arr, distance=10, prominence=15)
    valleys, _ = find_peaks(-ratings_arr, distance=10, prominence=15)
    cycles = generation_cycles(elo_history, team)
    if len(peaks) > 0 or len(valleys) > 0:
        st.caption(f"**Ciclos**: {len(peaks)} picos, {len(valleys)} vales. Duração média: {cycles['duracao_media']:.0f}j. Amplitude: {cycles['amplitude']:.0f} pts.")
    else:
        st.caption("Nenhum ciclo claro — evolução linear, sugerindo estabilidade institucional.")
    gw_start, gw_end = golden_window(elo_history, team, min_window=8, threshold_pct=0.95)
    if gw_start and gw_end:
        st.success(f"🏆 **Janela de Ouro**: {gw_start.strftime('%Y-%m-%d')} → {gw_end.strftime('%Y-%m-%d')}")
    else:
        st.info("Sem janela de ouro clara no período.")

st.divider()
st.subheader("🔄 Comparativo Temporal Cruzado")
s_h = get_team_history(elo_history, state['home_team'], n_last=200)
s_a = get_team_history(elo_history, state['away_team'], n_last=200)
if not s_h.empty and not s_a.empty:
    import plotly.graph_objects as go
    fig_comp = go.Figure()
    fig_comp.add_trace(go.Scatter(x=s_h['date'], y=s_h['rating'], mode='lines',
                                  name=state['home_team'], line=dict(color='#e94560', width=2)))
    fig_comp.add_trace(go.Scatter(x=s_a['date'], y=s_a['rating'], mode='lines',
                                  name=state['away_team'], line=dict(color='#0f3460', width=2)))
    fig_comp.update_layout(title="Elo Cruzado — Evolução Comparada", xaxis_title="Data", yaxis_title="Rating",
                           hovermode="x unified", paper_bgcolor='rgba(0,0,0,0)', plot_bgcolor='rgba(0,0,0,0)')
    st.plotly_chart(fig_comp, use_container_width=True)
