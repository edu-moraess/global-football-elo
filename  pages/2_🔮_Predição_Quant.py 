import streamlit as st
import numpy as np

from core.data_loader import load_data, get_processed_data, LOOKBACK_YEARS
from core.poisson_engine import predict_match, monte_carlo
from core.metrics_engine import elo_momentum, team_consistency, elo_efficiency
from components.sidebar import render_sidebar
from components.cards import metric_cards, info_box
from components.charts import plot_pie_probs, plot_heatmap_matrix, plot_radar
from components.tables import top_scores_table

st.set_page_config(page_title="Predição Quant", layout="wide")

df = load_data()
elo_ratings, elo_history, attack, defense, league_avg = get_processed_data(df, LOOKBACK_YEARS)
teams = sorted(list(elo_ratings.keys()))

state = render_sidebar(teams)
lookback = state['lookback']
if lookback != LOOKBACK_YEARS:
    elo_ratings, elo_history, attack, defense, league_avg = get_processed_data(df, lookback)

home, away, neutral = state['home_team'], state['away_team'], state['neutral']

st.markdown("<h2>🔮 Predição Quant Avançada</h2>", unsafe_allow_html=True)
st.markdown("""
<p style='color:#888; line-height:1.6;'>
O modelo Poisson-Dixon-Coles não adivinha o futuro. Ele <b>quantifica a incerteza</b>. 
Cada célula da matriz de placares é uma probabilidade, não uma certeza. O futebol é o esporte mais imprevisível 
do mundo — e este modelo respeita isso, ajustando a dependência entre gols (o famoso ρ de Dixon-Coles) 
que faz empates 0-0 e 1-1 serem mais comuns do que a matemática pura prevê.
</p>
""", unsafe_allow_html=True)

res = predict_match(home, away, neutral, attack, defense, league_avg, elo_ratings, rho=-0.08)
mc_h, mc_d, mc_a = monte_carlo(res['l_home'], res['l_away'], iterations=20000)

elo_diff = res['elo_home'] - res['elo_away']
supremacy = res['goal_supremacy']

narr = f"""
<b>{home}</b> ({res['elo_home']:.0f} Elo) vs. <b>{away}</b> ({res['elo_away']:.0f} Elo).<br>
Diferença de rating: <b>{elo_diff:+.0f}</b> pontos.<br>
Goal Supremacy projetado: <b>{supremacy:+.2f}</b> (expectativa de diferença de gols).<br>
{"O modelo detecta <b>vantagem significativa</b> para a casa." if supremacy > 0.8 else
 "Confronto <b>equilibrado</b> — o empate é o cenário mais provável." if abs(supremacy) < 0.3 else
 "O modelo favorece <b>levemente</b> o visitante." if supremacy < -0.3 else
 "O modelo favorece <b>levemente</b> a casa."}
"""
st.markdown(f"<div style='background:linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);padding:18px;border-radius:10px;margin:16px 0;'>"
              f"<p style='margin:0;color:#ccc;line-height:1.6'>{narr}</p></div>", unsafe_allow_html=True)

metric_cards([
    {'label': 'Elo Casa', 'value': f"{res['elo_home']:.0f}", 'delta': f"{elo_diff:+.0f}"},
    {'label': 'Elo Fora', 'value': f"{res['elo_away']:.0f}"},
    {'label': 'xG Casa', 'value': f"{res['xg_home']:.2f}"},
    {'label': 'xG Fora', 'value': f"{res['xg_away']:.2f}"},
    {'label': 'Goal Supremacy', 'value': f"{supremacy:+.2f}"},
], cols=5)

st.divider()
c1, c2 = st.columns(2)

with c1:
    st.subheader("🎲 Probabilidades (Monte Carlo 20k)")
    info_box("Monte Carlo simula 20.000 jogos independentes usando as taxas Poisson estimadas. "
             "O resultado é uma distribuição empírica que respeita a aleatoriedade do futebol.",
             type="info")
    plot_pie_probs([mc_h, mc_d, mc_a], [home, "Empate", away], ['#e94560', '#f0f0f0', '#0f3460'])
    xp_h = (mc_h * 3) + (mc_d * 1)
    xp_a = (mc_a * 3) + (mc_d * 1)
    st.info(f"**xP (Pontos Esperados):** {home}: {xp_h:.2f} | {away}: {xp_a:.2f}")

with c2:
    st.subheader("🎯 Matriz de Placares (Dixon-Coles)")
    info_box("Cada célula mostra a probabilidade de um placar específico. "
             "O ajuste ρ = -0.08 aumenta ligeiramente a probabilidade de empates 0-0, 1-0, 0-1 e 1-1.",
             type="info")
    plot_heatmap_matrix(res['matrix'], home, away)

st.divider()
c3, c4 = st.columns(2)
with c3:
    scores = [(f"{i}-{j}", res['matrix'][i, j]) for i in range(8) for j in range(8)]
    scores.sort(key=lambda x: x[1], reverse=True)
    st.markdown("**Top 5 Placares Prováveis**")
    top_scores_table(scores)

with c4:
    st.markdown("**Mercados de Gols & BTTS**")
    m = res['matrix']
    prob_over_15 = np.sum([m[i, j] for i in range(11) for j in range(11) if i + j > 1.5])
    prob_over_25 = np.sum([m[i, j] for i in range(11) for j in range(11) if i + j > 2.5])
    prob_over_35 = np.sum([m[i, j] for i in range(11) for j in range(11) if i + j > 3.5])
    prob_btts = np.sum([m[i, j] for i in range(1, 11) for j in range(1, 11)])
    m1, m2, m3, m4 = st.columns(4)
    m1.metric("Over 1.5", f"{prob_over_15:.1%}")
    m2.metric("Over 2.5", f"{prob_over_25:.1%}")
    m3.metric("Over 3.5", f"{prob_over_35:.1%}")
    m4.metric("BTTS", f"{prob_btts:.1%}")

st.subheader("🛡️ Radar de Força Quant")
categories = ['Ataque', 'Defesa', 'Elo', 'Momentum', 'Consistência', 'Eficiência']

def get_radar_stats(team, elo, att, defen, hist):
    s_att = np.clip(att.get(team, 1.0) * 50, 15, 100)
    s_def = np.clip((2.5 - defen.get(team, 1.0)) * 40, 15, 100)
    s_elo = np.clip((elo - 1000) / 12, 0, 100)
    mom = elo_momentum(hist, team, short_window=5, long_window=15)
    s_mom = np.clip(50 + (mom if mom is not np.nan else 0), 0, 100)
    consist = team_consistency(hist, team, n_last=20)
    s_cons = np.clip(100 - (consist * 1000 if consist is not np.nan else 50), 0, 100)
    eff_real, eff_edge = elo_efficiency(hist, team, n_last=20)
    s_eff = np.clip(50 + (-eff_edge * 30 if eff_edge is not np.nan else 0), 0, 100)
    return [s_att, s_def, s_elo, s_mom, s_cons, s_eff]

stats_h = get_radar_stats(home, res['elo_home'], attack, defense, elo_history)
stats_a = get_radar_stats(away, res['elo_away'], attack, defense, elo_history)
plot_radar(categories, stats_h, stats_a, home, away)
