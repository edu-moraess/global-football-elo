import streamlit as st
import numpy as np
import pandas as pd

st.set_page_config(page_title="Predição Quant", layout="wide", page_icon="🔮")

from components import inject_css, render_sidebar, section_header, narrative_box, ticker_bar
from components import plot_prob_donut, plot_score_heatmap, plot_radar
from components.theme import GOLD, RED, GREEN, BLUE, MUTED, TEXT
from core.data_loader import load_all, LOOKBACK_YEARS
from core.poisson_engine import predict_match, monte_carlo_match, score_distribution
from core.metrics_engine import elo_momentum, team_consistency, elo_efficiency

inject_css()

df, elo, hist, att, defe, ha, rho, lavg, mdf = load_all(LOOKBACK_YEARS)
teams = sorted(elo.keys())
state = render_sidebar(teams)
lookback = state['lookback']
if lookback != LOOKBACK_YEARS:
    df, elo, hist, att, defe, ha, rho, lavg, mdf = load_all(lookback)

home, away, neutral = state['home_team'], state['away_team'], state['neutral']

st.markdown("<h1>🔮 Predição Quant Avançada</h1>", unsafe_allow_html=True)
st.caption("Motor Dixon-Coles · MLE · Monte Carlo 30k iterações · Ajuste Elo")

res = predict_match(home, away, neutral, att, defe, ha, rho, lavg, elo)
mc_h, mc_d, mc_a = monte_carlo_match(res['lam_h'], res['lam_a'], 30_000, rho)

ticker_bar([
    (home, f"{res['elo_h']:.0f}", f"{res['elo_h'] - res['elo_a']:+.0f}"),
    (away, f"{res['elo_a']:.0f}", f"{res['elo_a'] - res['elo_h']:+.0f}"),
    ("xG Casa", f"{res['xg_h']:.2f}", ""),
    ("xG Fora", f"{res['xg_a']:.2f}", ""),
    ("Supremacy", f"{res['supremacy']:+.2f}", ""),
    ("Rho (DC)", f"{rho:.3f}", ""),
])

cols = st.columns(5)
metrics = [
    ("P(Casa)",  f"{mc_h:.1%}", f"Analítico: {res['p_home']:.1%}"),
    ("P(Empate)",f"{mc_d:.1%}", f"Analítico: {res['p_draw']:.1%}"),
    ("P(Fora)",  f"{mc_a:.1%}", f"Analítico: {res['p_away']:.1%}"),
    ("xP Casa",  f"{mc_h*3 + mc_d:.2f}", "pontos esperados"),
    ("xP Fora",  f"{mc_a*3 + mc_d:.2f}", "pontos esperados"),
]
for col, (label, val, delta) in zip(cols, metrics):
    col.metric(label, val, delta)

st.divider()

c1, c2 = st.columns(2)
with c1:
    section_header("Probabilidades — Monte Carlo 30k", "DONUT")
    plot_prob_donut(mc_h, mc_d, mc_a, home, away)
with c2:
    section_header("Matriz de Placares (Dixon-Coles)", "HEATMAP 7×7")
    plot_score_heatmap(res['matrix'], home, away)

st.divider()

c3, c4 = st.columns([1, 1])
with c3:
    section_header("Placares Mais Prováveis", "TOP 10")
    scores = score_distribution(res['matrix'], top_n=10)
    score_df = pd.DataFrame(scores, columns=['Placar', 'Probabilidade'])
    score_df['Probabilidade'] = score_df['Probabilidade'].map('{:.2%}'.format)
    st.dataframe(score_df, use_container_width=True, hide_index=True)

with c4:
    section_header("Mercados de Gols", "OVER/UNDER · BTTS")
    M = res['matrix']
    n = M.shape[0]
    markets = {
        'Over 0.5': sum(M[i,j] for i in range(n) for j in range(n) if i+j > 0),
        'Over 1.5': sum(M[i,j] for i in range(n) for j in range(n) if i+j > 1),
        'Over 2.5': sum(M[i,j] for i in range(n) for j in range(n) if i+j > 2),
        'Over 3.5': sum(M[i,j] for i in range(n) for j in range(n) if i+j > 3),
        'Over 4.5': sum(M[i,j] for i in range(n) for j in range(n) if i+j > 4),
        'BTTS (Sim)': sum(M[i,j] for i in range(1,n) for j in range(1,n)),
        'Gols Par':   sum(M[i,j] for i in range(n) for j in range(n) if (i+j) % 2 == 0),
        'Gols Ímpar': sum(M[i,j] for i in range(n) for j in range(n) if (i+j) % 2 == 1),
    }
    mkt_df = pd.DataFrame(list(markets.items()), columns=['Mercado', 'Probabilidade'])
    mkt_df['Probabilidade'] = mkt_df['Probabilidade'].map('{:.1%}'.format)
    st.dataframe(mkt_df, use_container_width=True, hide_index=True)

st.divider()
section_header("Radar de Força Quantitativa", "COMPARATIVO")
categories = ['Ataque', 'Defesa', 'Elo', 'Momentum', 'Consistência', 'Eficiência']

def _radar_vals(team, elo_r, att_d, def_d, hist_df):
    s_att  = float(np.clip(att_d.get(team, 1.0) * 50, 10, 100))
    s_def  = float(np.clip((2.5 - def_d.get(team, 1.0)) * 40, 10, 100))
    s_elo  = float(np.clip((elo_r.get(team, 1500) - 1000) / 12, 0, 100))
    mom    = elo_momentum(hist_df, team)
    s_mom  = float(np.clip(50 + (mom if pd.notna(mom) else 0), 0, 100))
    cons   = team_consistency(hist_df, team)
    s_cons = float(np.clip(100 - (cons * 1200 if pd.notna(cons) else 50), 0, 100))
    eff_r, eff_e = elo_efficiency(hist_df, team)
    s_eff  = float(np.clip(50 + (eff_e * 25 if pd.notna(eff_e) else 0), 0, 100))
    return [s_att, s_def, s_elo, s_mom, s_cons, s_eff]

vals_h = _radar_vals(home, elo, att, defe, hist)
vals_a = _radar_vals(away, elo, att, defe, hist)
plot_radar(categories, vals_h, vals_a, home, away)

st.divider()
fav   = home if mc_h > mc_a else away
p_fav = max(mc_h, mc_a)
narrative_box(
    "📌 Síntese do Modelo",
    f"<b>{fav}</b> é favorito com probabilidade de vitória de <b>{p_fav:.1%}</b>. "
    f"xG esperado: {home} {res['xg_h']:.2f} — {away} {res['xg_a']:.2f}. "
    f"Supremacy: {res['supremacy']:+.2f}. "
    f"Probabilidade de BTTS: {markets['BTTS (Sim)']:.1%}. "
    f"Over 2.5: {markets['Over 2.5']:.1%}. "
    f"O modelo foi calibrado com rho = {rho:.3f} (correlação Dixon-Coles).",
)