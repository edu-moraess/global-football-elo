import streamlit as st
import pandas as pd
import numpy as np

st.set_page_config(page_title="Inteligência Elo", layout="wide", page_icon="🧠")

from components import inject_css, render_sidebar, ticker_bar, stat_card, section_header, narrative_box
from components import plot_conf_scatter, plot_momentum_bar
from components.theme import GOLD, RED, GREEN, MUTED, BLUE
from core.data_loader import load_all, LOOKBACK_YEARS
from core.elo_engine import CONFEDERATIONS

inject_css()

df, elo, hist, att, defe, ha, rho, lavg, mdf = load_all(LOOKBACK_YEARS)
teams = sorted(elo.keys())
state = render_sidebar(teams)
lookback = state['lookback']
if lookback != LOOKBACK_YEARS:
    from core.data_loader import load_all
    df, elo, hist, att, defe, ha, rho, lavg, mdf = load_all(lookback)

mdf = mdf.reset_index(drop=True)
mdf.index += 1

st.markdown(f"<h1>🧠 Inteligência Elo Global</h1>", unsafe_allow_html=True)
st.caption("Motor: Elo K-dinâmico · pesos por torneio · goal-diff multiplier não-linear")

top5 = mdf.head(5)
ticker_items = []
for _, row in top5.iterrows():
    mom = row['Momentum']
    delta = f"+{mom:.0f}" if pd.notna(mom) and mom > 0 else f"{mom:.0f}" if pd.notna(mom) else "—"
    ticker_items.append((row['Seleção'], f"{row['Elo']:.0f}", delta))
ticker_bar(ticker_items)

col_rank, col_team = st.columns([3, 1])

with col_rank:
    section_header("Ranking Quantitativo Global", "TODAS AS SELEÇÕES")
    conf_filter = st.selectbox("Filtrar por Confederação",
                               ['Todas'] + sorted(CONFEDERATIONS.keys()),
                               label_visibility='collapsed')
    view_df = mdf if conf_filter == 'Todas' else mdf[mdf['Confederação'] == conf_filter]

    display = view_df[['Seleção','Confederação','Elo','Momentum','Volatilidade',
                        'Edge','Forma','BrierScore','Consistência']].copy()
    display.columns = ['Seleção','Conf','Elo','Momentum','Volat.','Edge','Forma','Brier','Consist.']

    def _color_elo(val):
        if pd.isna(val): return ''
        if val > 0: return f'color:{GREEN}'
        if val < 0: return f'color:{RED}'
        return ''

    styled = display.style\
        .format({'Elo': '{:.0f}', 'Momentum': '{:+.1f}', 'Volat.': '{:.1f}',
                 'Edge': '{:+.2f}', 'Forma': '{:.2f}', 'Brier': '{:.3f}',
                 'Consist.': '{:.4f}'}, na_rep='—')\
        .applymap(_color_elo, subset=['Momentum','Edge'])\
        .background_gradient(subset=['Elo'], cmap='YlOrBr')

    st.dataframe(styled, use_container_width=True, height=480)

with col_team:
    section_header("Perfil da Seleção", "ANÁLISE INDIVIDUAL")
    for team in [state['home_team'], state['away_team']]:
        row = mdf[mdf['Seleção'] == team]
        if row.empty:
            st.warning(f"{team} sem dados.")
            continue
        r = row.iloc[0]
        rank = mdf[mdf['Seleção'] == team].index[0]
        mom  = r['Momentum']
        trend = "ascensão" if pd.notna(mom) and mom > 15 \
                else "declínio" if pd.notna(mom) and mom < -15 else "estabilidade"
        trend_color = GREEN if trend == "ascensão" else (RED if trend == "declínio" else MUTED)
        narrative_box(
            f"{team}  ·  #{rank} Mundial",
            f"Rating: <b style='color:{GOLD}'>{r['Elo']:.0f}</b> "
            f"&nbsp;|&nbsp; Conf: {r['Confederação']}<br>"
            f"Tendência: <b style='color:{trend_color}'>{trend}</b> ({mom:+.1f} pts)<br>"
            f"Volatilidade: {r['Volatilidade']:.1f} &nbsp;|&nbsp; "
            f"Forma: {r['Forma']:.2f}<br>"
            f"Brier Score: {r['BrierScore']:.3f} &nbsp;|&nbsp; Edge: {r['Edge']:+.2f}",
        )
        st.markdown("<div style='margin:8px 0'></div>", unsafe_allow_html=True)

st.divider()
section_header("Distribuição de Força por Confederação", "ANÁLISE MACRO")
conf_stats = mdf.groupby('Confederação').agg(
    **{'Média Elo': ('Elo','mean'), 'Desvio': ('Elo','std'),
       'Máximo': ('Elo','max'), 'Seleções': ('Elo','count')}
).reset_index()
plot_conf_scatter(conf_stats)

st.divider()
section_header("Times em Ascensão / Declínio", "MOMENTUM RECENTE (MA5 – MA15)")
c1, c2 = st.columns(2)
with c1:
    top_rise = mdf.dropna(subset=['Momentum']).sort_values('Momentum', ascending=False).head(12)
    plot_momentum_bar(top_rise)
with c2:
    top_fall = mdf.dropna(subset=['Momentum']).sort_values('Momentum').head(12)
    plot_momentum_bar(top_fall)