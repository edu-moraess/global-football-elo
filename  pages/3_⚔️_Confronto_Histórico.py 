import streamlit as st
import pandas as pd
import numpy as np

st.set_page_config(page_title="Confronto Histórico", layout="wide", page_icon="⚔️")

from components import inject_css, render_sidebar, section_header, narrative_box, ticker_bar, stat_card
from components.charts import plot_h2h_timeline
from components.theme import GOLD, RED, GREEN, MUTED, BLUE
from core.data_loader import load_all, LOOKBACK_YEARS
from core.metrics_engine import h2h_stats

inject_css()

df, elo, hist, att, defe, ha, rho, lavg, mdf = load_all(LOOKBACK_YEARS)
teams = sorted(elo.keys())
state = render_sidebar(teams)
home, away = state['home_team'], state['away_team']

st.markdown("<h1>⚔️ Confronto Histórico</h1>", unsafe_allow_html=True)
st.caption("Análise de head-to-head, dominância psicológica e evolução temporal dos confrontos")

lookback_h2h = st.slider("Janela de análise (anos)", 5, 50, 30, key='h2h_lb')
stats = h2h_stats(df, home, away, lookback=lookback_h2h)

if stats['total'] == 0:
    st.warning(f"Nenhum confronto registrado entre {home} e {away} nos últimos {lookback_h2h} anos.")
    st.stop()

ticker_bar([
    ("Total jogos",      str(stats['total']), ""),
    (f"Vitórias {home}", str(stats['wins_a']), f"{stats['wins_a']/stats['total']:.0%}"),
    ("Empates",          str(stats['draws']),  f"{stats['draws']/stats['total']:.0%}"),
    (f"Vitórias {away}", str(stats['wins_b']), f"{stats['wins_b']/stats['total']:.0%}"),
    ("Saldo Gols",       f"{stats['gd_sum']:+d}", ""),
    ("Streak (casa)",    str(stats['streak']), "vitórias consecutivas"),
])

c1, c2, c3, c4 = st.columns(4)
with c1: stat_card(f"Vitórias {home}", str(stats['wins_a']), f"{stats['wins_a']/stats['total']:.1%}")
with c2: stat_card("Empates",          str(stats['draws']),  f"{stats['draws']/stats['total']:.1%}")
with c3: stat_card(f"Vitórias {away}", str(stats['wins_b']), f"{stats['wins_b']/stats['total']:.1%}")
with c4:
    dom = stats['dominance']
    col = GOLD if dom > 0.12 else (RED if dom < -0.12 else MUTED)
    stat_card("Índice de Dominância", f"{dom:+.2f}", stats['edge'], accent=col)

st.divider()
narrative_box(
    "📌 Diagnóstico Psicológico",
    f"Em {stats['total']} confrontos desde {stats['first'].year if stats['first'] else '—'}, "
    f"<b>{stats['edge']}</b>. "
    f"Saldo de gols acumulado: <b>{stats['gd_sum']:+d}</b>. "
    f"Maior sequência de vitórias de {home}: <b>{stats['streak']} jogos consecutivos</b>. "
    f"Último confronto: {stats['last'].strftime('%d/%m/%Y') if stats['last'] else '—'}.",
)

section_header("Linha do Tempo dos Confrontos", "HISTÓRICO COMPLETO")

mask = (
    ((df['home_team'] == home) & (df['away_team'] == away)) |
    ((df['home_team'] == away) & (df['away_team'] == home))
)
h2h_df = df[mask].sort_values('date').copy()
cutoff = df['date'].max() - pd.Timedelta(days=365 * lookback_h2h)
h2h_df = h2h_df[h2h_df['date'] >= cutoff]

def _gd_a(row):
    if row['home_team'] == home:
        return row['home_score'] - row['away_score']
    return row['away_score'] - row['home_score']

def _score_label(row):
    if row['home_team'] == home:
        return f"{home} {row['home_score']}–{row['away_score']} {away}"
    return f"{home} {row['away_score']}–{row['home_score']} {away}"

h2h_df['gd_a']  = h2h_df.apply(_gd_a, axis=1)
h2h_df['score'] = h2h_df.apply(_score_label, axis=1)

if not h2h_df.empty:
    plot_h2h_timeline(h2h_df, home, away)

section_header("Confrontos Detalhados", "TABELA")
display_h2h = h2h_df[['date','home_team','home_score','away_score','away_team','tournament','neutral']]\
    .sort_values('date', ascending=False).copy()
display_h2h['date'] = display_h2h['date'].dt.strftime('%d/%m/%Y')
display_h2h.columns = ['Data','Casa','G.Casa','G.Fora','Fora','Torneio','Neutro']
st.dataframe(display_h2h, use_container_width=True, hide_index=True, height=320)

st.divider()
section_header("Desempenho por Torneio", "BREAKDOWN")
tourn_stats = []
for tourn, grp in h2h_df.groupby('tournament'):
    wins   = (grp['gd_a'] > 0).sum()
    draws  = (grp['gd_a'] == 0).sum()
    losses = (grp['gd_a'] < 0).sum()
    tourn_stats.append(dict(
        Torneio=tourn, Jogos=len(grp),
        **{f'V {home}': wins, 'E': draws, f'D {home}': losses},
        Saldo=int(grp['gd_a'].sum()),
    ))
tourn_df = pd.DataFrame(tourn_stats).sort_values('Jogos', ascending=False)
st.dataframe(tourn_df, use_container_width=True, hide_index=True)