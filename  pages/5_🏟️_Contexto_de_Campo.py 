import streamlit as st
from core.data_loader import load_data, get_processed_data, LOOKBACK_YEARS
from core.metrics_engine import get_confederation, home_advantage_by_confederation
from core.poisson_engine import predict_match
from components.sidebar import render_sidebar
from components.charts import plot_waterfall
from components.cards import info_box

st.set_page_config(page_title="Contexto de Campo", layout="wide")

df = load_data()
elo_ratings, elo_history, attack, defense, league_avg = get_processed_data(df, LOOKBACK_YEARS)
teams = sorted(list(elo_ratings.keys()))
state = render_sidebar(teams)
home, away, neutral = state['home_team'], state['away_team'], state['neutral']

st.title("🏟️ Contexto de Campo")
st.markdown("A altitude de La Paz. O calor de Manaus. O gelo de Reykjavík. A vantagem de casa é geografia, fisiologia e psicologia.")

from core.elo_engine import CONFEDERATIONS
ha_df = home_advantage_by_confederation(df, elo_history, CONFEDERATIONS)
if not ha_df.empty:
    st.subheader("🌍 Home Advantage por Confederação")
    import plotly.express as px
    fig_ha = px.bar(ha_df.sort_values('Advantage Index', ascending=True),
                    x='Advantage Index', y='Confederação', orientation='h',
                    color='Advantage Index', color_continuous_scale='RdYlGn',
                    text='Advantage Index',
                    labels={'Advantage Index': 'Índice de Vantagem'})
    fig_ha.update_traces(texttemplate='%{text:.2%}', textposition='outside')
    fig_ha.update_layout(paper_bgcolor='rgba(0,0,0,0)', plot_bgcolor='rgba(0,0,0,0)')
    st.plotly_chart(fig_ha, use_container_width=True)

st.divider()
st.subheader("⚖️ Análise Contextual do Confronto")
conf_h = get_confederation(home)
conf_a = get_confederation(away)
ctx = f"""**{home}** ({conf_h}) vs. **{away}** ({conf_a}).
{"Campo neutro — vantagem de casa neutralizada." if neutral else f"Jogo em casa para **{home}**. Na **{conf_h}**, a vantagem de casa é {'significativa' if conf_h in ['CONMEBOL', 'CAF'] else 'moderada'}."}
{"Confronto inter-confederação — adaptação tática e fuso horário podem ser fatores." if conf_h != conf_a else "Confronto intra-confederação — familiaridade tática elevada."}
"""
st.markdown(ctx)

if not neutral:
    st.subheader("📉 Impacto da Neutralidade")
    res_neutral = predict_match(home, away, True, attack, defense, league_avg, elo_ratings, rho=-0.08)
    res_home = predict_match(home, away, False, attack, defense, league_avg, elo_ratings, rho=-0.08)
    delta_h = res_home['p_home'] - res_neutral['p_home']
    delta_d = res_home['p_draw'] - res_neutral['p_draw']
    delta_a = res_home['p_away'] - res_neutral['p_away']
    d1, d2, d3 = st.columns(3)
    d1.metric(f"Δ Prob {home}", f"{delta_h:+.1%}")
    d2.metric("Δ Prob Empate", f"{delta_d:+.1%}")
    d3.metric(f"Δ Prob {away}", f"{delta_a:+.1%}")
    plot_waterfall([home, "Empate", away], [delta_h * 100, delta_d * 100, delta_a * 100],
                   title="Impacto da Vantagem de Campo (pp)")
