# --- Seção 3: What-If Elo Shift ---
st.divider()
st.subheader("🌍 What-If: Impacto Global de Elo")
info_box("Simulamos o efeito cascata de uma mudança de Elo em um único time. Se o Brasil ganha +100 Elo por um título, "
         "quantas posições ele sobe? E quem é empurrado para baixo? O futebol internacional é um sistema zero-sum: "
         "a ascensão de um é relativa à queda de outro.",
         type="info")

whatif_team = st.selectbox("Time para simular mudança", teams, index=teams.index(home))
whatif_shift = st.slider("Δ Elo", -200, 200, 50)

if st.button("🌍 Calcular Impacto Global", type="primary"):
    with st.spinner("Recalculando ranking global..."):
        impact_df = what_if_elo_shift(elo_ratings, whatif_team, whatif_shift, teams)
    st.subheader(f"Impacto de {whatif_shift:+.0f} Elo para {whatif_team}")
    styled_table(impact_df.head(20), {'Elo Original': '{:.0f}', 'Elo Novo': '{:.0f}',
                                        'Posição Original': '{:.0f}', 'Posição Nova': '{:.0f}',
                                        'Δ Posição': '{:+.0f}'})

    most_impacted = impact_df.nlargest(10, 'Δ Posição')
    import plotly.express as px
    fig = px.bar(most_impacted, x='Seleção', y='Δ Posição',
                 title=f"Times Mais Impactados por {whatif_shift:+.0f} Elo em {whatif_team}",
                 color='Δ Posição', color_continuous_scale='RdYlGn')
    fig.update_layout(paper_bgcolor='rgba(0,0,0,0)', plot_bgcolor='rgba(0,0,0,0)')
    st.plotly_chart(fig, use_container_width=True)

# --- Seção 4: Robustez do Modelo ---
st.divider()
st.subheader("🛡️ Robustez do Modelo Poisson-Dixon-Coles")
info_box("O parâmetro ρ (rho) controla o ajuste de dependência para empates de baixo placar. "
         "ρ = 0 significa Poisson independente (sem correção). ρ = -0.08 é o valor padrão do futebol. "
         "Testamos diferentes valores para mostrar a estabilidade (ou instabilidade) das predições.",
         type="info")

rho_values = [-0.15, -0.10, -0.08, -0.05, 0.0, 0.05]
robust_rows = []
for rho in rho_values:
    res = predict_match(home, away, neutral, attack, defense, league_avg, elo_ratings, rho=rho)
    robust_rows.append({
        'ρ (rho)': rho,
        'Prob Casa': res['p_home'],
        'Prob Empate': res['p_draw'],
        'Prob Fora': res['p_away'],
        'Supremacy': res['goal_supremacy']
    })
robust_df = pd.DataFrame(robust_rows)
styled_table(robust_df, {'Prob Casa': '{:.1%}', 'Prob Empate': '{:.1%}', 'Prob Fora': '{:.1%}',
                         'Supremacy': '{:.2f}'})

info_box("<b>Interpretação:</b> ρ negativo indica que empates de baixo placar (0-0, 1-0, 0-1, 1-1) são mais prováveis "
         "do que o Poisson independente preveria. Isso é típico do futebol: quando o placar está apertado, times tendem a "
         "'fechar' o jogo, reduzindo a taxa de gols. O modelo sem ρ (ρ=0) superestima vitórias e subestima empates.",
         type="info")
