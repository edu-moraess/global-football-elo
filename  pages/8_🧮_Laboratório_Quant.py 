shift_range = st.slider("Range de Variação Elo", -400, 400, (-200, 200), step=50)
n_points = st.slider("Pontos de simulação", 5, 21, 9)

if st.button("🔬 Executar Sensibilidade", type="primary"):
    with st.spinner("Calculando curvas de sensibilidade..."):
        sens_df = sensitivity_analysis(home, away, neutral, attack, defense, league_avg, elo_ratings,
