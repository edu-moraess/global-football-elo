import streamlit as st
import pandas as pd
import numpy as np

st.set_page_config(page_title="Métricas Avançadas", layout="wide", page_icon="📊")

from components import inject_css, render_sidebar, section_header, narrative_box, ticker_bar, stat_card
from components.charts import plot_elo_evolution
from components.theme import GOLD, RED, GREEN, MUTED, BLUE
from core.data_loader import load_all, LOOKBACK_YEARS
from core.metrics_engine import (
    _team_series, brier_score, clutch_performance, xg_over_expected,
    schedule_strength, elo_efficiency, form_index,
)

inject_css()

df, elo, hist, att, defe, ha, rho, lavg, mdf = load_all(LOOKBACK_YEARS)
teams = sorted(elo.keys())
state = render_sidebar(teams)
home, away = state['home_team'], state['away_team']

st.markdown("<h1>📊 Métricas Avançadas</h1>", unsafe_allow_html=True)
st.caption("Brier Score, Clutch Index, xGOE, Força de Agenda — além do Elo bruto")

tab_h, tab_a, tab_comp = st.tabs([f"🟡 {home}", f"🔵 {away}", "⚖️ Comparativo"])


def _render_team(team, color):
    s = _team_series(hist, team)
    if s.empty:
        st.warning(f"Sem histórico para {team}.")
        return

    last_elo    = s['elo_after'].iloc[-1]
    bs          = brier_score(hist, team)
    clutch      = clutch_performance(hist, team)
    xgoe        = xg_over_expected(hist, team)
    sched       = schedule_strength(hist, team)
    eff_r, eff_e = elo_efficiency(hist, team)
    fi          = form_index(hist, team)
    n_games     = len(s)

    ticker_bar([
        ("Elo atual",    f"{last_elo:.0f}", ""),
        ("Brier Score",  f"{bs:.3f}" if pd.notna(bs) else "—", "↓ melhor"),
        ("Clutch Index", f"{clutch:+.2f}" if pd.notna(clutch) else "—", ""),
        ("xGOE",         f"{xgoe:+.2f}" if pd.notna(xgoe) else "—", "gols/jogo"),
        ("Força Agenda", f"{sched:.0f}" if pd.notna(sched) else "—", "Elo médio opp."),
        ("Eficiência",   f"{eff_r:.2f}" if pd.notna(eff_r) else "—", "pts/jogo"),
        ("Forma (5j)",   f"{fi:.2f}" if pd.notna(fi) else "—", "ponderada exp."),
        ("Partidas",     str(n_games), f"últimos {LOOKBACK_YEARS}a"),
    ])

    c1, c2, c3, c4 = st.columns(4)
    with c1: stat_card("Brier Score",    f"{bs:.3f}" if pd.notna(bs) else "—",
                       "Calibração do motor. ↓ = melhor", accent=color)
    with c2: stat_card("Clutch Index",   f"{clutch:+.2f}" if pd.notna(clutch) else "—",
                       "Oficial vs. amistosos", accent=color)
    with c3: stat_card("xGOE",          f"{xgoe:+.2f}" if pd.notna(xgoe) else "—",
                       "Gols reais − proxy xG", accent=color)
    with c4: stat_card("Força de Agenda",f"{sched:.0f}" if pd.notna(sched) else "—",
                       "Elo médio dos adversários", accent=color)

    st.divider()
    section_header(f"Evolução do Rating — {team}", "SÉRIE TEMPORAL")
    plot_elo_evolution(s, team, color)

    section_header("Últimas 20 Partidas", "HISTÓRICO RECENTE")
    last20 = s.tail(20)[['date','opponent','venue','goals_for','goals_against',
                          'result','expected','delta_elo','tournament']].copy()
    last20['date']     = last20['date'].dt.strftime('%d/%m/%Y')
    last20['result']   = last20['result'].map({1.0:'W', 0.5:'D', 0.0:'L'})
    last20['delta_elo']= last20['delta_elo'].map('{:+.1f}'.format)
    last20['expected'] = last20['expected'].map('{:.2%}'.format)
    last20.columns = ['Data','Oponente','Campo','GP','GC','Res','xP(vitória)','ΔElo','Torneio']
    st.dataframe(last20.sort_values('Data', ascending=False),
                 use_container_width=True, hide_index=True, height=320)

    section_header("Performance por Torneio", "BREAKDOWN")
    tb = s.groupby('tournament').agg(
        Jogos=('result','count'),
        Vitórias=('result', lambda x: (x==1).sum()),
        Empates=('result', lambda x: (x==0.5).sum()),
        Derrotas=('result', lambda x: (x==0).sum()),
        **{'Gols Pró': ('goals_for','mean'),
           'Gols Con': ('goals_against','mean'),
           'ΔElo Médio': ('delta_elo','mean')}
    ).reset_index().sort_values('Jogos', ascending=False)
    tb['Gols Pró']  = tb['Gols Pró'].map('{:.2f}'.format)
    tb['Gols Con']  = tb['Gols Con'].map('{:.2f}'.format)
    tb['ΔElo Médio']= tb['ΔElo Médio'].map('{:+.1f}'.format)
    st.dataframe(tb, use_container_width=True, hide_index=True)


with tab_h: _render_team(home, GOLD)
with tab_a: _render_team(away, BLUE)

with tab_comp:
    section_header("Comparativo de Métricas", "LADO A LADO")
    metrics_rows = []
    for team in [home, away]:
        bs      = brier_score(hist, team)
        clutch  = clutch_performance(hist, team)
        xgoe    = xg_over_expected(hist, team)
        sched   = schedule_strength(hist, team)
        eff_r, eff_e = elo_efficiency(hist, team)
        fi      = form_index(hist, team)
        row_m   = mdf[mdf['Seleção'] == team]
        vol     = row_m['Volatilidade'].iloc[0] if not row_m.empty else np.nan
        mom     = row_m['Momentum'].iloc[0]     if not row_m.empty else np.nan
        metrics_rows.append(dict(
            Seleção=team, Elo=elo.get(team,1500),
            Momentum=mom, Volatilidade=vol,
            **{'Brier Score': bs, 'Clutch Index': clutch, 'xGOE': xgoe,
               'Força Agenda': sched, 'Eficiência pts': eff_r, 'Forma (5j)': fi}
        ))

    comp_df = pd.DataFrame(metrics_rows).T
    comp_df.columns = comp_df.iloc[0]
    comp_df = comp_df.iloc[1:]
    st.dataframe(comp_df.style.format(
        lambda x: f"{float(x):.3f}" if isinstance(x, (int,float)) and pd.notna(x) else str(x),
        na_rep='—'
    ), use_container_width=True)

    narrative_box(
        "📌 Glossário de Métricas",
        "<b>Brier Score</b>: erro quadrático médio das probabilidades previstas vs. resultados reais. ↓ melhor.<br>"
        "<b>Clutch Index</b>: performance em jogos oficiais menos amistosos. Positivo = mais forte no que importa.<br>"
        "<b>xGOE</b>: gols marcados reais por jogo menos proxy de xG. Positivo = sobreperformance de finalização.<br>"
        "<b>Força de Agenda</b>: Elo médio dos adversários nos últimos 10 jogos. Contextualiza o rating.<br>"
        "<b>Eficiência</b>: pontos reais por jogo. Comparado ao esperado pelo modelo (Edge)."
    )